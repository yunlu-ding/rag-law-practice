# ============================================================
# 金融监管法规知识库 · 配置模板
#
# 用法：把本文件复制为 .env，再按实际情况填写。
#       .env 里放的是密钥，等于密码，不要提交到任何公开仓库。
#
# 设计原则：**除应用本身外，所有外部依赖都是可选的。**
# 这样在还没接数据库、还没配模型 Key 的时候服务也能起来，
# 前端会直接显示"哪些依赖已就绪、哪些还没配"，而不是启动失败。
# ============================================================

# ===== 应用 =====
APP_NAME=金融监管法规知识库
APP_ENV=development
DEBUG=true

# ===== 大模型（阶段三启用，现在可留空）=====
# 百炼（通义千问）：对话 + 向量化 + 重排，三件套同一个 Key
DASHSCOPE_API_KEY=
MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v1

# DeepSeek：只做文本生成（据官方说明没有 embedding 接口）
DEEPSEEK_API_KEY=
# 生成模型选择：tongyi / deepseek
GENERATION_PROVIDER=tongyi

# ===== 向量库 Milvus / Zilliz Cloud（阶段三启用）=====
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=vibe_regulation_knowledge
MILVUS_DIMENSION=1536

# ===== 关系库 PostgreSQL（阶段二启用）=====
POSTGRES_DSN=

# ===== 检索参数（阶段三起生效，改这里即可做对照实验）=====
RETRIEVAL_TOP_K=5
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2
RERANK_CANDIDATE_K=100

# ===== 知识边界（阶段三启用）=====
# 检索最高分低于这个阈值时直接拒答，不进生成。
# 需要靠评测校准，不要凭感觉填。
REFUSE_SCORE_THRESHOLD=0.0

# ===== 上传与存储 =====
STORAGE_ROOT=storage
MAX_UPLOAD_SIZE_MB=100

# ===== 演示限额（阶段四启用）=====
RATE_LIMIT_PER_IP_PER_MIN=20
SESSION_TURN_LIMIT=30
DAILY_BUDGET_CNY=10
# 按次数封顶（推荐）：金额需要单价、单价会变，次数不会失效
DAILY_QA_LIMIT_PER_IP=30
DAILY_QA_LIMIT_GLOBAL=300
# 本地开发可以设 false；**上线前必须确认它是 true**
LIMITS_ENABLED=true
# 演示模式：真机问答需要口令（可选）
DEMO_MODE=false
DEMO_PASSCODE=
